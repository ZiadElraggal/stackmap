    {
      "id": "OrdersTable",
      "name": "stackmap-orders",
      "resource_type": "AWS::DynamoDB::Table",
      "provider": "aws",
      "category": "database",
      "properties": {
        "TableName": "stackmap-orders",
        "BillingMode": "PAY_PER_REQUEST",
        "AttributeDefinitions": [
          {
            "AttributeName": "orderId",
            "AttributeType": "S"
          }
        ],
        "KeySchema": [
          {
            "AttributeName": "orderId",
            "KeyType": "HASH"
          }
        ]
      },
      "tags": {},
      "position_hint": {
        "tier": "data",
        "weight": 5,
        "is_helper": false
      }
    },
    {
      "id": "AuditQueue",
      "name": "stackmap-audit-events",
      "resource_type": "AWS::SQS::Queue",
      "provider": "aws",
      "category": "queue",
      "properties": {
        "QueueName": "stackmap-audit-events"
      },
      "tags": {},
      "position_hint": {
        "tier": "backend",
        "weight": 4,
        "is_helper": false
      }
    },
    {
      "id": "OrdersRole",
      "name": "stackmap-orders-role",
      "resource_type": "AWS::IAM::Role",
      "provider": "aws",
      "category": "security",
      "properties": {
        "RoleName": "stackmap-orders-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OrdersAppAccess",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:Query"
                  ],
                  "Resource": {
                    "Fn::GetAtt": "OrdersTable.Arn"
                  }
                },
                {
                  "Effect": "Allow",
                  "Action": [
                    "sqs:SendMessage"
                  ],
                  "Resource": {
                    "Fn::GetAtt": "AuditQueue.Arn"
                  }
                }
              ]
            }
          }
        ]
      },
      "tags": {},
      "position_hint": {
        "tier": "backend",
        "weight": 2,
        "is_helper": false
      }
    },
    {
      "id": "SharedLayer",
      "name": "SharedLayer",
      "resource_type": "AWS::Serverless::LayerVersion",
      "provider": "aws",
      "category": "compute",
      "properties": {
        "LayerName": "stackmap-shared-layer",
        "CompatibleRuntimes": [
          "python3.12"
        ],
        "ContentUri": "layer/"
      },
      "tags": {},
      "position_hint": {
        "tier": "backend",
        "weight": 1,
        "is_helper": true,
        "logical_parent": "OrdersFunction"
      }
    },
    {
      "id": "OrdersFunction",
      "name": "stackmap-orders-api",
      "resource_type": "AWS::Serverless::Function",
      "provider": "aws",
      "category": "compute",
      "properties": {
        "FunctionName": "stackmap-orders-api",
        "Handler": "orders.handler",
        "Runtime": "python3.12",
        "CodeUri": "src/orders/",
        "Role": {
          "Fn::GetAtt": "OrdersRole.Arn"
        },
        "Layers": [
          {
            "Ref": "SharedLayer"
          }
        ],
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "OrdersTable"
            },
            "AUDIT_QUEUE_URL": {
              "Ref": "AuditQueue"
            }
          }
        },
        "Events": {
          "ListOrders": {
            "Type": "HttpApi",
            "Properties": {
              "ApiId": {
                "Ref": "PublicHttpApi"
              },
              "Path": "/orders",
              "Method": "GET"
            }
          }
        }
      },
      "tags": {},
      "position_hint": {
        "tier": "backend",
        "weight": 2,
        "is_helper": false
      }
    },
    {
      "id": "WorkerFunction",
      "name": "stackmap-orders-worker",
      "resource_type": "AWS::Serverless::Function",
      "provider": "aws",
      "category": "compute",
      "properties": {
        "FunctionName": "stackmap-orders-worker",
        "Handler": "worker.handler",
        "Runtime": "python3.12",
        "CodeUri": "src/worker/",
        "Role": {
          "Fn::GetAtt": "OrdersRole.Arn"
        },
        "Layers": [
          {
            "Ref": "SharedLayer"
          }
        ],
        "Environment": {
          "Variables": {
            "TABLE_NAME": {
              "Ref": "OrdersTable"
            }
          }
        },
        "Events": {
          "OrdersQueueEvent": {
            "Type": "SQS",
            "Properties": {
              "Queue": {
                "Fn::GetAtt": "AuditQueue.Arn"
              },
              "BatchSize": 10
            }
          }
        }
      },
      "tags": {},
      "position_hint": {
        "tier": "backend",
        "weight": 2,
        "is_helper": false
      }
    },
    {
      "id": "OrdersStateMachine",
      "name": "stackmap-orders-flow",
      "resource_type": "AWS::Serverless::StateMachine",
      "provider": "aws",
      "category": "integration",
      "properties": {
        "Name": "stackmap-orders-flow",
        "Role": {
          "Fn::GetAtt": "OrdersRole.Arn"
        },
        "Definition": {
          "Fn::Sub": "{\n  \"Comment\": \"Order workflow\",\n  \"StartAt\": \"ProcessOrder\",\n  \"States\": {\n    \"ProcessOrder\": {\n      \"Type\": \"Task\",\n      \"Resource\": \"${WorkerFunction.Arn}\",\n      \"End\": true\n    }\n  }\n}"
        }
      },
      "tags": {},
      "position_hint": {
        "tier": "api",
        "weight": 2,
        "is_helper": false
      }
    }
