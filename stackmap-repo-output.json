      "properties": {
        "ApiId": {
          "Ref": "PublicHttpApi"
        },
        "IntegrationType": "AWS_PROXY",
        "IntegrationUri": {
          "Fn::GetAtt": "OrdersFunction.Arn"
        },
        "PayloadFormatVersion": "2.0"
      },
