    {
      "id": "GetOrdersRoute",
      "name": "GetOrdersRoute",
      "resource_type": "AWS::ApiGatewayV2::Route",
      "provider": "aws",
      "category": "integration",
      "properties": {
        "ApiId": {
          "Ref": "PublicHttpApi"
        },
        "RouteKey": "GET /orders",
        "AuthorizationType": "JWT",
        "AuthorizerId": {
          "Ref": "ApiAuthorizer"
        },
        "Target": {
          "Fn::Sub": "integrations/${GetOrdersIntegration}"
        }
      },
      "tags": {},
      "position_hint": {
        "tier": "api",
        "weight": 1,
        "is_helper": true,
