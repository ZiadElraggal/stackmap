        {
          "schema_version": 0,
          "attributes": {
            "id": "assets-public",
            "bucket": "assets-public",
            "acl": "public-read",
            "arn": "arn:aws:s3:::assets-public",
            "tags": {}
          },
          "sensitive_attributes": []
        }
      ]
    }
  ]
}
