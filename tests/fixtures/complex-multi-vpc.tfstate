      "instances": [
        {
          "schema_version": 1,
          "attributes": {
            "id": "E1A2B3C4D5E6F7",
            "arn": "arn:aws:cloudfront::123456789012:distribution/E1A2B3C4D5E6F7",
            "domain_name": "d1a2b3c4e5f6g7.cloudfront.net",
            "status": "Deployed",
            "enabled": true,
            "is_ipv6_enabled": true,
            "aliases": ["app.example.com"],
            "origin": [
              {
                "domain_name": "main-alb-123456789.us-east-1.elb.amazonaws.com",
                "origin_id": "alb-origin",
                "custom_origin_config": [
                  {
                    "http_port": 80,
                    "https_port": 443,
                    "origin_protocol_policy": "https-only",
                    "origin_ssl_protocols": ["TLSv1.2"]
                  }
                ]
              },
              {
                "domain_name": "app-assets-123456789012.s3.us-east-1.amazonaws.com",
                "origin_id": "s3-origin",
                "s3_origin_config": [
                  {
                    "origin_access_identity": "origin-access-identity/cloudfront/E2A3B4C5D6E7F8"
                  }
                ]
              }
            ],
            "default_cache_behavior": [
              {
                "allowed_methods": ["GET", "HEAD", "OPTIONS", "PUT", "POST", "PATCH", "DELETE"],
                "cached_methods": ["GET", "HEAD"],
                "target_origin_id": "alb-origin",
                "viewer_protocol_policy": "redirect-to-https",
                "compress": true
              }
            ],
            "ordered_cache_behavior": [
              {
                "path_pattern": "/static/*",
                "target_origin_id": "s3-origin",
                "viewer_protocol_policy": "redirect-to-https",
                "allowed_methods": ["GET", "HEAD"],
                "cached_methods": ["GET", "HEAD"],
                "compress": true
              }
            ],
