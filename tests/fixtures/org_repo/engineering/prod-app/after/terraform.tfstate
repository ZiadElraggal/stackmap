    {
      "mode": "managed",
      "type": "aws_sfn_state_machine",
      "name": "data_pipeline",
      "provider": "provider[\"registry.terraform.io/hashicorp/aws\"]",
      "instances": [
        {
          "schema_version": 0,
          "attributes": {
            "id": "arn:aws:states:us-east-1:210000000002:stateMachine:data-pipeline",
            "name": "data-pipeline",
            "arn": "arn:aws:states:us-east-1:210000000002:stateMachine:data-pipeline",
            "role_arn": "arn:aws:iam::210000000002:role/data-pipeline-sfn-role",
            "status": "ACTIVE",
            "type": "STANDARD",
            "creation_date": "2024-11-15T10:30:00Z",
            "definition": "{\"Comment\":\"Data processing pipeline: ingest, process, store\",\"StartAt\":\"IngestData\",\"States\":{\"IngestData\":{\"Type\":\"Task\",\"Resource\":\"arn:aws:lambda:us-east-1:210000000002:function:ingest-handler\",\"Comment\":\"Ingest raw data and validate schema\",\"ResultPath\":\"$.ingestResult\",\"Next\":\"ProcessData\",\"Retry\":[{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":5,\"MaxAttempts\":3,\"BackoffRate\":2.0}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"PipelineFailed\",\"ResultPath\":\"$.error\"}]},\"ProcessData\":{\"Type\":\"Task\",\"Resource\":\"arn:aws:lambda:us-east-1:210000000002:function:process-worker\",\"Comment\":\"Transform and enrich the ingested data\",\"InputPath\":\"$\",\"ResultPath\":\"$.processResult\",\"Next\":\"StoreData\",\"Retry\":[{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":10,\"MaxAttempts\":2,\"BackoffRate\":2.0}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"PipelineFailed\",\"ResultPath\":\"$.error\"}]},\"StoreData\":{\"Type\":\"Task\",\"Resource\":\"arn:aws:lambda:us-east-1:210000000002:function:store-writer\",\"Comment\":\"Persist processed data to DynamoDB and S3\",\"InputPath\":\"$\",\"ResultPath\":\"$.storeResult\",\"Next\":\"PipelineSucceeded\",\"Retry\":[{\"ErrorEquals\":[\"States.TaskFailed\"],\"IntervalSeconds\":5,\"MaxAttempts\":3,\"BackoffRate\":2.0}],\"Catch\":[{\"ErrorEquals\":[\"States.ALL\"],\"Next\":\"PipelineFailed\",\"ResultPath\":\"$.error\"}]},\"PipelineSucceeded\":{\"Type\":\"Succeed\"},\"PipelineFailed\":{\"Type\":\"Fail\",\"Error\":\"PipelineError\",\"Cause\":\"One or more pipeline stages failed\"}}}",
            "logging_configuration": [
              {
                "include_execution_data": true,
                "level": "ERROR",
                "log_destination": ""
              }
            ],
            "tags": {
              "Environment": "production",
              "Project": "stackmap-demo"
            },
            "tags_all": {
              "Environment": "production",
              "Project": "stackmap-demo"
            }
          },
